---
import Layout from '../layouts/Layout.astro';

let items = [
    {
        id: "legacy",
        title: "Legacy",
        description: "Access the legacy canvas not optimized for mobile devices."
    },
    {
        id: "modern",
        title: "Modern",
        description: "Access the modern canvas that is optimized for performance and mobile devices."
    }
]
---

<Layout>
    <div class="flex flex-col w-full h-screen justify-center items-center">
        <a href="/" class="flex flex-row items-center gap-2" style={{
            fontFamily: "var(--font-display)",
            animation: "fade-up 0.4s ease",
        }}>
            <img src="/favicon.svg" alt="Layouter Logo" class={"w-8 h-8 md:h-16 md:w-16"}/>
            <span class={"text-3xl md:text-7xl"}>Layouter</span>
        </a>
        <div class="flex flex-col sm:flex-row w-full p-4 sm:p-0 sm:w-auto gap-4 mt-12">
            {items.map((item, i) => (
                <a href=`${item.id}` style={{
                    fontFamily: "var(--font-display)",
                    animation: `fade-up ${(i * 0.2) + 0.6}s ease`,
                }} class="border border-[var(--color-border)] text-center text-[var(--color-muted-text)] hover:text-[var(--color-text)] hover:bg-(--color-hover) text-xs bg-transparent py-4 px-12 rounded-xl cursor-pointer duration-300 hover:translate-y-[5px]">{item.title}</a>
            ))}
        </div>
    </div>
</Layout>
